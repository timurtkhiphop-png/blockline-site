{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:full",
  "outputDirectory": "out",
  "installCommand": "npm ci",
  "framework": null,
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
